{
  "name": "readme-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Design, generate and auto-update animated GitHub profile READMEs",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/core",
    "packages/engine",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "bundle": "npm run bundle -w packages/engine",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "npm run cli -w packages/engine -- build --config ../../examples/readme.config.json --out ../../examples/dist --mock"
  },
  "devDependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.1",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@types/node": "22.20.7",
    "fast-xml-parser": "^5.3.0",
    "opentype.js": "^2.0.0",
    "simple-icons": "^16.38.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  }
}
