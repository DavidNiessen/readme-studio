{
  "name": "readme-studio",
  "version": "1.1.0",
  "private": true,
  "description": "Design animated, self-updating GitHub profile and project READMEs in the browser; a GitHub Action re-renders them on a schedule.",
  "keywords": [
    "github",
    "readme",
    "profile-readme",
    "github-action",
    "svg",
    "animation",
    "readme-generator",
    "open-source"
  ],
  "homepage": "https://readme.niessen.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidNiessen/readme-studio.git"
  },
  "bugs": {
    "url": "https://github.com/DavidNiessen/readme-studio/issues"
  },
  "author": "David Nießen (https://niessen.dev)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/core",
    "packages/engine",
    "apps/web",
    "apps/extension"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "bundle": "npm run bundle -w packages/engine",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "npm run cli -w packages/engine -- build --config ../../examples/readme.config.json --out ../../examples/dist --mock",
    "extension": "npm run build -w apps/extension"
  },
  "devDependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.1",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@types/node": "22.20.7",
    "fast-xml-parser": "^5.3.0",
    "opentype.js": "^2.0.0",
    "simple-icons": "^16.38.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  }
}
